%% ==================================================================================
%% ФАЙЛ: bpmn_retrain.mmd
%% BPMN-ДИАГРАММА (блок-схема) ПЕРEOБУЧЕНИЯ МОДЕЛИ
%% "Классификатор текстовых сообщений: обычное / спам / кликбейт" (v1.0 -> v1.N+1)
%% Запускается из BPMN 'Эксплуатация' (шлюз G04) либо по расписанию/накоплению данных.
%% Дорожки: Мониторинг; Владелец бизнеса; Команда данных (Data); DS-команда; MLOps (деплой).
%% Human-in-the-loop: G05 (целесообразность), R12 (согласование деплоя).
%% ==================================================================================

flowchart TB

subgraph RL1["Дорожка 1. Мониторинг (SAS Model Monitor)"]
    R01(("Триггер: F1w<0.92 / F1(2)<0.85 / PSI>0.2 /<br/>накоплено >= 10 000 меток модератора /<br/>плановый срок 6 мес")) --> R02["R02 Заявка на переобучение:<br/>метрики деградации, причина, ожидаемый эффект"]
end

subgraph RL2["Дорожка 2. Владелец бизнеса (согласование)"]
    R02 --> G05{"G05 Целесообразно переобучение?<br/>(эффект > затрат, риск приемлем)"}
    G05 -->|"нет"| R03["R03 Отклонить заявку,<br/>архивировать с причиной"] --> R_END1(("Конец"))
    G05 -->|"да"| R04["R04 Утвердить объём, сроки, SLA<br/>обновлённой модели"]
end

subgraph RL3["Дорожка 3. Данные (команда Data)"]
    R04 --> R05["R05 Сбор данных: df.csv v(N+1) =<br/>df.csv v1 + метки модератора (T10) + свежие разметки"]
    R05 --> R06["R06 Валидация данных: дубликаты, баланс классов,<br/>двойная выборочная разметка (шум меток)"]
    R06 --> G06{"G06 Данные пригодны?<br/>(баланс, объём, качество меток)"}
    G06 -->|"нет"| R05
    G06 -->|"да"| R07["R07 Train/Test 80/20 stratify, seed 42;<br/>версия датасета фиксируется в Git"]
end

subgraph RL4["Дорожка 4. Обучение (DS-команда)"]
    R07 --> R08["R08 Обучение пайплайна model.ipynb:<br/>clean_text -> TF-IDF word(1-2)+char_wb(3-5)<br/>-> LogReg, GridSearch C по f1_weighted (StratifiedKFold 3)"]
    R08 --> R09["R09 Авто-валидация challenger на отложенном Test"]
    R09 --> G07{"G07 Quality gates: challenger >= чемпион?<br/>F1w >= 0.9455 И F1(2) >= 0.8823<br/>И Recall(0) >= 0.9522"}
    G07 -->|"нет"| R10["R10 Анализ причин (фичи, баланс, пороги),<br/>доработка пайплайна"] --> R08
    G07 -->|"да"| R11["R11 Shadow-тест 1-2 недели: challenger параллельно<br/>скорит живой трафик, решения не применяются"]
end

subgraph RL5["Дорожка 5. Деплой и контроль (MLOps + бизнес)"]
    R11 --> G08{"G08 На живом трафике challenger<br/>не хуже чемпиона и SLA бизнеса соблюдены?"}
    G08 -->|"нет"| R03
    G08 -->|"да"| R12["R12 BPMN-согласование: подписи владельца бизнеса<br/>и риск-функции (human-in-the-loop)"]
    R12 --> R13["R13 Деплой: canary 10% трафика -> 100%;<br/>регистрация v1.(N+1) в SAS Model Manager;<br/>обновление Model Card и аудит-записи"]
    R13 --> R14["R14 Усиленный мониторинг 14 дней;<br/>затем переход в штатную эксплуатацию<br/>(BPMN 'Эксплуатация', файл bpmn_operation.mmd)"]
    R14 --> R_END2(("Конец: модель в эксплуатации"))
end

%% ---------------------------- ДЕТАЛЬНОЕ ОПИСАНИЕ ШАГОВ ----------------------------
%% R01 Триггеры согласованы с шлюзами G03/G04 BPMN 'Эксплуатация' и разд. 4 Model Card:
%%     стойкое нарушение SLA-полов (F1w<0.92, F1(2)<0.85, ошибка на обычных>6%, PSI>0.2),
%%     накопление >= 10 000 новых меток модератора, плановый цикл 6 месяцев, изменение
%%     бизнес-правил (новые типы спама/кликбейта).
%% R02 Заявка содержит: текущие мониторинговые метрики, гипотезу причины деградации,
%%     оценку эффекта (см. задачу 2) и требуемый объём данных.
%% G05/R03/R04 Владелец бизнеса принимает решение по заявке; отказ архивируется для аудита.
%% R05-R07 Данные: новая версия df.csv версионируется в Git (требование Model Card, разд. 6);
%%     обязательны удаление полных дубликатов (в v1 их было 26.4%) и стратификация, т.к.
%%     классы несбалансированы (60.4/21.7/17.9% после дедупликации).
%% R08 Пайплайн воспроизводит чемпион (model.ipynb, 'Модель 2'): те же предобработка и
%%     векторизаторы; подбор C повторяется GridSearchCV по f1_weighted (StratifiedKFold 3).
%% G07 Пороги = метрики чемпиона на тесте v1 (0.9455 / 0.8823 / 0.9522): challenger обязан
%%     быть не хуже чемпиона, иначе возврат к доработке (R10).
%% R11 Shadow-тест исключает риск для бизнеса: challenger только считает, не решает.
%% G08/R12 Сравнение чемпион-challenger на живом трафике + подписи бизнеса и рисков.
%% R13 Canary-деплой ограничивает радиус инцидента 10% трафика; Model Card обновляется
%%     одновременно с версией (разделы 3, 6, 8), аудит фиксирует смену чемпиона.
%% R14 Две недели усиленного мониторинга (ежедневные отчёты вместо еженедельных), затем
%%     процесс передаётся в штатную эксплуатацию (файл bpmn_operation.mmd).
%% ==================================================================================
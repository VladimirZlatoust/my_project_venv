%% ==================================================================================
%% ФАЙЛ: bpmn_operation.mmd
%% BPMN-ДИАГРАММА (блок-схема) ЭКСПЛУАТАЦИИ МОДЕЛИ
%% "Классификатор текстовых сообщений: обычное / спам / кликбейт"
%% Версия модели: 1.0 (чемпион = "Модель 2" из model.ipynb: TF-IDF word+char + LogReg C=10)
%% Нотация: ((..)) - события, [..] - задачи, {..} - шлюзы (условия), subgraph - дорожки ролей.
%% Дорожки (роли): 1) Источник сообщений; 2) Сервис скоринга (SAS MAS); 3) Бизнес
%% (модератор/редактор); 4) Аудит и обратная связь; 5) Мониторинг и управление (MLOps,
%% владелец бизнеса). Human-in-the-loop: T07, T08, T12, T13.
%% ==================================================================================

flowchart TB

subgraph LANE1["Дорожка 1. Источник сообщений (входящий поток)"]
    E_START(("Старт: входящее сообщение / заголовок")) --> T01["T01 Приём сообщения по API<br/>поля: msg_id, text, timestamp"]
end

subgraph LANE2["Дорожка 2. Сервис скоринга (SAS Micro Analytic Service, модель v1.0)"]
    T01 --> T02["T02 Предобработка clean_text:<br/>нижний регистр, ё→е, HTML/URL→токен URL,<br/>числа→NUM, удалены небуквенные символы"]
    T02 --> T03["T03 Скоринг: TF-IDF word(1-2)+char_wb(3-5)<br/>+ LogisticRegression(C=10, balanced)<br/>выход: P0, P1, P2, class = argmax"]
    T03 --> G01{"G01 Шлюз уверенности:<br/>max P >= 0.60 ?"}
end

subgraph LANE3["Дорожка 3. Решения и маршрутизация (авто + человек)"]
    G01 -->|"да, class = 0"| T04["T04 Авто-решение: доставить / опубликовать"]
    G01 -->|"да, class = 1"| T05["T05 Авто-решение: карантин (блокировка спам)"]
    G01 -->|"да, class = 2"| G02{"G02 Шлюз кликбейта:<br/>P2 >= 0.80 ?"}
    G02 -->|"да"| T06["T06 Авто-решение: понизить приоритет<br/>+ выборка 10% на проверку редактором"]
    G02 -->|"нет"| T07["T07 Ручная проверка редактором:<br/>опубликовать / править / отклонить"]
    G01 -->|"нет (серая зона)"| T08["T08 Ручная разметка модератором<br/>(эталонная метка-исправление)"]
end

subgraph LANE4["Дорожка 4. Аудит и обратная связь"]
    T04 --> T09["T09 Журналирование: признаки, P0-P2, решение,<br/>версия модели, время (audit trail SAS)"]
    T05 --> T09
    T06 --> T09
    T07 --> T09
    T08 --> T09
    T07 --> T10["T10 Накопление меток модератора/редактора<br/>(контрольная выборка = ground truth)"]
    T08 --> T10
end

subgraph LANE5["Дорожка 5. Мониторинг и управление (MLOps + владелец бизнеса)"]
    T09 --> T11["T11 Ежедневный мониторинг (SAS Model Monitor):<br/>PSI вероятностей, баланс классов, доля серой зоны,<br/>качество на контрольной выборке, latency, SLA"]
    T10 --> T11
    T11 --> G03{"G03 Шлюз SLA нарушен?<br/>F1w < 0.92 ИЛИ F1(кликбейт) < 0.85<br/>ИЛИ ошибка на обычных > 6% ИЛИ PSI > 0.2"}
    G03 -->|"нет"| T12["T12 Еженедельный отчёт владельцу бизнеса:<br/>доля авто-решений, доли блоков, жалобы"]
    T12 --> E_CYCLE(("Цикл: следующее сообщение"))
    E_CYCLE -.-> E_START
    G03 -->|"да"| T13["T13 Инцидент: алерт MLOps и бизнесу,<br/>подпорог серой зоны вверх / резервные правила"]
    T13 --> G04{"G04 Системная деградация?<br/>(нужно переобучение)"}
    G04 -->|"нет"| T12
    G04 -->|"да"| E_RETRAIN(("Передача: BPMN 'Переобучение'<br/>(файл bpmn_retrain.mmd)"))
end


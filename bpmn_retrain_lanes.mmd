flowchart TB
    classDef svc fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0d47a1
    classDef usr fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1b5e20
    classDef gate fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#e65100
    classDef ev fill:#ECEFF1,stroke:#37474F,stroke-width:2px,color:#102027
    classDef sub fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#4A148C

    subgraph Q1["ПУЛ 1 · Мониторинг и триггеры (MLOps)"]
        direction TB
        A1(("▶ R01 Триггер")):::ev
        A2[/"R02 Заявка на переобучение"/]:::svc
        A1 --> A2
    end
    subgraph Q2["ПУЛ 2 · Бизнес-владелец"]
        direction TB
        B1{"✕ G05 Целесообразно?"}:::gate
        B2[/"R04 Утверждение объёма и SLA"/]:::usr
        B3[/"R14 Согласование деплоя"/]:::usr
        B4[/"R11 Пауза: нужен разбор"/]:::usr
        B5[/"R03 Отказ, архив"/]:::svc
        B1 -->|"да"| B2
        B1 -->|"нет"| B5
        B2 --> B3
    end
    subgraph Q3["ПУЛ 3 · Команда данных"]
        direction TB
        C1[/"R05 Сбор и версионирование данных"/]:::svc
        C2[/"R06 Валидация данных"/]:::svc
        C3{"✕ G06 Данные пригодны?"}:::gate
        C4[/"R07 Разбиение и фиксация версии"/]:::svc
        C1 --> C2 --> C3
        C3 -->|"да"| C4
        C3 -->|"нет · досылка"| C1
    end
    subgraph Q4["ПУЛ 4 · DS-команда"]
        direction TB
        D1[/"R08 Обучение challenger"/]:::svc
        D2[/"R09 Авто-валидация"/]:::svc
        D3{"✕ G07 Не хуже чемпиона?"}:::gate
        D4[/"R10 Анализ причин и доработка"/]:::svc
        D5{"✕ G08 Попыток не больше 3?"}:::gate
        D6[/"R12 Валидация аналитиком"/]:::usr
        D7[/"R13 Теневой тест"/]:::svc
        D8{"✕ G09 Не хуже на трафике?"}:::gate
        D1 --> D2 --> D3
        D3 -->|"нет"| D4 --> D1
        D3 -->|"да"| D5
        D5 -->|"нет · пауза"| D4
        D5 -->|"да"| D6
        D6 -->|"отклонил"| D4
        D6 -->|"одобрил"| D7 --> D8
    end
    subgraph Q5["ПУЛ 5 · MLOps: деплой и контроль"]
        direction TB
        E1[/"R15 Регистрация + Model Card"/]:::svc
        E2[/"R16 Деплой canary 10 % → 100 %"/]:::svc
        E3[/"R17 Усиленный мониторинг 14 дней"/]:::svc
        E4[["Онбординг версии<br/>01 Разработка → 02 Валидация → 03 Утверждение → 04 Деплой"]]:::sub
        E5(("■ В эксплуатацию")):::ev
        E4 --> E1 --> E2 --> E3 --> E5
    end

    A2 -.-> B1
    B2 -.-> C1
    C4 -.-> D1
    D8 -.->|"да"| B3
    D8 -.->|"нет"| B5
    D5 -.->|"нет · пауза"| B4
    B3 -.->|"одобрил"| E1
    B3 -.->|"отклонил"| B5
    E5 -.->|"возврат в эксплуатацию"| A1
